---
---
<dialog id="search" aria-label="Search">
  <div class="box">
    <div class="field">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="search-input" type="search" placeholder="Search writing…" autocomplete="off" spellcheck="false" aria-controls="search-results" />
      <kbd>esc</kbd>
    </div>
    <ul id="search-results" role="listbox"></ul>
    <p class="hint" id="search-hint">Search titles, descriptions, tags and full text.</p>
  </div>
</dialog>

<style>
  dialog {
    width: min(36rem, calc(100vw - 2rem)); max-height: 70vh;
    margin: 12vh auto auto; padding: 0;
    border: 1px solid var(--rule); border-radius: 10px;
    background: var(--bg); color: var(--fg);
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.25);
    font-family: var(--sans);
  }
  dialog::backdrop { background: rgb(20 20 18 / 0.35); backdrop-filter: blur(2px); }
  .box { display: flex; flex-direction: column; max-height: 70vh; }
  .field {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.9rem 1rem; border-bottom: 1px solid var(--rule); color: var(--muted);
  }
  input {
    flex: 1; min-width: 0; border: 0; outline: 0; background: transparent;
    font: inherit; font-size: 1rem; color: var(--fg);
  }
  input::-webkit-search-cancel-button { display: none; }
  kbd {
    font-family: var(--sans); font-size: 0.7rem; color: var(--faint);
    border: 1px solid var(--rule); border-radius: 4px; padding: 0.05rem 0.35rem;
  }
  .hint { margin: 0; padding: 0.75rem 1rem; font-size: 0.78rem; color: var(--faint); }
</style>

<style is:global>
  #search ul { list-style: none; margin: 0; padding: 0.35rem; overflow-y: auto; }
  #search ul:empty { display: none; }
  #search li a {
    display: block; padding: 0.6rem 0.75rem; border-radius: 6px; text-decoration: none;
  }
  #search li a[aria-selected='true'] { background: var(--accent-soft); }
  #search li a[aria-selected='true'] .t { color: var(--accent); }
  #search .t { font-family: var(--serif); font-size: 1.02rem; display: block; line-height: 1.35; }
  #search .m { font-size: 0.75rem; color: var(--muted); display: block; margin-top: 0.15rem; }
  #search .s { font-size: 0.8rem; color: var(--muted); display: block; margin-top: 0.25rem; line-height: 1.45; }
  #search .s mark { background: var(--accent-soft); color: var(--fg); border-radius: 2px; }
</style>

<script>
  type Entry = { title: string; url: string; date: string; type: string; description: string; tags: string[]; body: string };

  const dialog = document.getElementById('search') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const hint = document.getElementById('search-hint') as HTMLParagraphElement;
  let index: Entry[] | null = null;
  let selected = 0;

  async function load() {
    if (index) return index;
    const res = await fetch('/search.json');
    index = (await res.json()) as Entry[];
    return index;
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    load();
  }

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function snippet(body: string, terms: string[]) {
    const lower = body.toLowerCase();
    let at = -1;
    for (const t of terms) { at = lower.indexOf(t); if (at !== -1) break; }
    if (at === -1) return '';
    const start = Math.max(0, at - 60);
    let text = (start > 0 ? '…' : '') + body.slice(start, at + 110) + '…';
    let html = esc(text);
    for (const t of terms) {
      html = html.replace(new RegExp(`(${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi'), '<mark>$1</mark>');
    }
    return html;
  }

  function render(q: string) {
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    if (!terms.length || !index) { list.innerHTML = ''; hint.hidden = false; hint.textContent = 'Search titles, descriptions, tags and full text.'; return; }
    const scored = index
      .map((e) => {
        const title = e.title.toLowerCase(), desc = e.description.toLowerCase();
        const tags = e.tags.join(' ').toLowerCase(), body = e.body.toLowerCase();
        let score = 0;
        for (const t of terms) {
          const s = (title.includes(t) ? 10 : 0) + (tags.includes(t) ? 5 : 0) + (desc.includes(t) ? 3 : 0) + (body.includes(t) ? 1 : 0);
          if (!s) return { e, score: 0 };
          score += s;
        }
        return { e, score };
      })
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 12);

    selected = 0;
    hint.hidden = scored.length > 0;
    hint.textContent = 'No results.';
    list.innerHTML = scored
      .map(({ e }, i) => {
        const snip = snippet(e.body, terms);
        return `<li><a href="${e.url}" role="option" aria-selected="${i === 0}">
          <span class="t">${esc(e.title)}</span>
          <span class="m">${esc(e.type)} · ${esc(e.date)}</span>
          ${snip ? `<span class="s">${snip}</span>` : ''}
        </a></li>`;
      })
      .join('');
  }

  function move(d: number) {
    const items = list.querySelectorAll('a');
    if (!items.length) return;
    items[selected]?.setAttribute('aria-selected', 'false');
    selected = (selected + d + items.length) % items.length;
    items[selected].setAttribute('aria-selected', 'true');
    items[selected].scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('input', async () => { await load(); render(input.value); });
  input.addEventListener('keydown', (ev) => {
    if (ev.key === 'ArrowDown') { ev.preventDefault(); move(1); }
    else if (ev.key === 'ArrowUp') { ev.preventDefault(); move(-1); }
    else if (ev.key === 'Enter') {
      const a = list.querySelectorAll('a')[selected];
      if (a) { ev.preventDefault(); location.href = a.href; }
    }
  });
  dialog.addEventListener('click', (ev) => { if (ev.target === dialog) dialog.close(); });
  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (ev) => {
    const tag = (ev.target as HTMLElement)?.tagName;
    const typing = tag === 'INPUT' || tag === 'TEXTAREA' || (ev.target as HTMLElement)?.isContentEditable;
    if ((ev.key === '/' && !typing) || (ev.key.toLowerCase() === 'k' && (ev.metaKey || ev.ctrlKey))) {
      ev.preventDefault();
      open();
    }
  });
</script>
