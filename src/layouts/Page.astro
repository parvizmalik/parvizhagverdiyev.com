---
import Base from './Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <h1 class="h">{frontmatter.title}</h1>
  <div class="prose"><slot /></div>
  {frontmatter.social && (
    <section class="elsewhere">
      <h2 class="label">Elsewhere</h2>
      <SocialLinks />
    </section>
  )}
</Base>
<style>
  .h { font-size: 1.9rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 2rem; line-height: 1.15; }
  .elsewhere { margin-top: 3rem; }
  .label {
    font-family: var(--sans); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--faint); margin: 0;
  }
</style>
