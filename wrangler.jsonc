// Cloudflare deploy settings. `npx wrangler deploy` uploads the built site in ./dist.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parvizhagverdiyev-com",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
